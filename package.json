{
  "name": "@upande/mobile-kit",
  "version": "0.16.0",
  "description": "Drop-in Settings page for Expo apps: OTA + APK updates from GitHub, biometric unlock, device register and version info, backed by a Frappe app.",
  "license": "MIT",
  "private": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "bin",
    "cli",
    "plugins",
    "shared",
    "templates",
    "app.plugin.js",
    ".github/workflows/release.yml",
    "README.md",
    "LICENSE",
    "!cli/check-shipped.mjs"
  ],
  "bin": {
    "upande-mobile-kit": "bin/upande-mobile-kit.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --ci && jest --ci -c jest.web.config.js && node --test __tests__/cli/*.test.mjs",
    "check:pack": "npm pack --dry-run --json > /dev/null && node cli/check-shipped.mjs"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "expo": ">=54",
    "expo-application": ">=7",
    "expo-constants": ">=18",
    "expo-file-system": ">=19",
    "expo-router": ">=6",
    "expo-sensors": ">=14",
    "expo-updates": ">=29",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-device-info": ">=10"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-intent-launcher": {
      "optional": true
    },
    "expo-local-authentication": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-updates": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-judah/upande-mobile-kit.git"
  },
  "homepage": "https://github.com/mark-judah/upande-mobile-kit#readme",
  "bugs": {
    "url": "https://github.com/mark-judah/upande-mobile-kit/issues"
  },
  "author": "Upande <dev@upande.com>",
  "keywords": [
    "expo",
    "react-native",
    "ota",
    "expo-updates",
    "frappe",
    "apk",
    "biometric"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
